# Connection string do pooler do Supabase em modo transaction (porta 6543), usuário postgres
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Segunda trava (RLS por casa, migração 011): mesmo endereço com o usuário app_api.
# Com ela, o dia a dia usa app_api e o DATABASE_URL acima fica só para login e convites.
DATABASE_URL_APP=postgresql://app_api.SEU_PROJETO:SENHA_DO_APP_API@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Alternativa: DATABASE_URL com app_api e esta com o dono (postgres). Deixe vazia se usar a forma acima.
DATABASE_URL_SISTEMA=

# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# E-mail do administrador: dono da casa com os dados antigos e único que convida clientes novos
ALLOWED_EMAIL=seu-email@exemplo.com

# Endereço do frontend (CORS). Em desenvolvimento o localhost já é liberado.
FRONTEND_URL=http://localhost:5173

# Segredo do Vercel Cron (gere um texto aleatório longo)
CRON_SECRET=troque-por-um-texto-aleatorio-longo

# Só na demonstração pública: e-mail do login de demonstração (dados recriados todo dia)
DEMO_EMAIL=
